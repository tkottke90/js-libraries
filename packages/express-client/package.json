{
  "name": "@tkottke/express-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "express-client-init": "./bin/init.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@tkottke-js-helpers/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@tkottke90/js-errors": "*",
    "vitest": "*",
    "zod": "*"
  },
  "scripts": {
    "build": "tsc --build tsconfig.lib.json && esbuild --bundle src/index.ts --outdir=dist --format=esm --platform=node --target=es2022 --packages=external",
    "test": "vitest run",
    "lint": "eslint ."
  }
}
