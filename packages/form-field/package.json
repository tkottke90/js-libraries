{
  "name": "@tkottke90/form-field",
  "version": "0.1.0-alpha",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@preact/signals": "*",
    "preact": "*"
  },
  "scripts": {
    "build": "tsc --build tsconfig.lib.json && esbuild --bundle src/index.ts --outdir=dist --format=esm --platform=node --target=es2022 --packages=external --jsx=automatic --jsx-import-source=preact",
    "test": "vitest run",
    "lint": "eslint ."
  }
}
